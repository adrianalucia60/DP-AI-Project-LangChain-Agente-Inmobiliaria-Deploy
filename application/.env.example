# ============================================
# Plantilla de variables de entorno
# Copiar a .env y rellenar con los valores propios:  cp .env.example .env
#
# El .env real NUNCA se sube al repo (está en .gitignore).
# Autor: Ing. Kevin Inofuente Colque - DataPath
# ============================================

# ============================================
# OpenAI (LLM + embeddings)  [REQUERIDA]
# ============================================
# El modelo se configura en model_config/model_config.yaml, no acá.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# PostgreSQL — Histórico de Conversación (Supabase)  [REQUERIDAS]
# Las lee conversation_history/postgres_chat_history.py
# ============================================
# Usuario del pooler de Supabase: postgres.<ref-del-proyecto>
DB_USER=postgres.tu-project-ref
DB_PASSWORD=tu-password-de-la-base
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Opcional: tabla donde se guardan los mensajes (por defecto: chat_history)
#DB_CHAT_TABLE=chat_history

# ============================================
# Base de Conocimiento (RAG) — Qdrant del VPS  [REQUERIDAS]
# Las lee RAG-Clasico-con-Qdrant/rag.py (ingesta)
# ============================================
# Sin puerto: el proxy del VPS publica Qdrant en el 443 de https, no en el 6333.
QDRANT_URL=https://qdrant.tu-dominio.com
QDRANT_API_KEY=tu-api-key-de-qdrant
# Nombre de la colección. Convención: prefijo tenant_id_
QDRANT_COLLECTION=tenant_id_alpha_state

# ============================================
# Búsqueda en internet (Tavily)  [REQUERIDA]
# La lee tools/Busqueda_internet.py — revienta al importar si falta
# ============================================
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Chatwoot (canal de mensajería)  [REQUERIDAS para main_chatwoot.py]
# No hacen falta si solo usas el agente por CLI
# ============================================
CHATWOOT_BASE_URL=https://chatwoot.tu-dominio.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=tu-token-de-chatwoot
# Etiqueta que el bot retira de la conversación al derivar a un humano
CHATWOOT_BOT_LABEL=atiende-ia

# ============================================
# Zona horaria del agente  [OPCIONAL]
# Default si falta: America/Lima. Tiene prioridad sobre model_config.yaml
# ============================================
AGENT_TIMEZONE=America/Lima

# ============================================
# Google Sheets (Tool del boleto de los locatarios)  [REQUERIDAS]
# Las lee tools/Google_Sheets.py
# ============================================
# ID de la hoja: parte de la URL entre /d/ y /edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
# Nombre exacto de la pestaña a leer (la que tiene los cálculos del mes)
GOOGLE_SHEETS_WORKSHEET=Rio Sul
# Fila donde están los nombres de columna (Bloque, Responsable, etc.)
GOOGLE_SHEETS_HEADER_ROW=2
# Opcional: fila con las agrupaciones por encima de los headers.
# Por defecto, la fila inmediatamente anterior a HEADER_ROW.
#GOOGLE_SHEETS_GROUP_ROW=1
# Ruta al JSON de la cuenta de servicio (relativa al proyecto o absoluta).
# El archivo va en credentials/, que está en .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# ============================================
# HEREDADAS — ningún módulo del proyecto las lee hoy
# Descomentar solo si vuelves a usar Gemini, Pinecone o Supabase-RAG.
# ============================================
#GEMINI_API_KEY=
#PINECONE_API_KEY=
#PINECONE_INDEX_NAME=
#SUPABASE_URL=
#SUPABASE_SERVICE_KEY=
